-- AUTO PARRY
-- ============================================================
local networkModule = nil
local parryConn = nil
local lastParry = 0

task.spawn(function()
    pcall(function()
        networkModule = require(ReplicatedStorage.Modules.Network.Network)
    end)
end)

local function fallbackParry()
    if not S.PunchOnBlock then return end
    if os.clock() - lastParry < 0.15 then return end
    lastParry = os.clock()
    task.spawn(function()
        task.wait(0.05)
        firePunch()
        stopHDT()
    end)
end

local function installParryHook()
    if parryConn then return end
    if not networkModule then return end
    pcall(function()
        parryConn = networkModule:SetConnection(
            ("%*1337ParryIcon"):format(LocalPlayer.Name),
            "REMOTE_EVENT",
            function(blocked)
                if blocked == true and S.PunchOnBlock then
                    if os.clock() - lastParry < 0.2 then return end
                    lastParry = os.clock()
                    firePunch()
                    stopHDT()
                end
            end
        )
        print("[HB] Parry hook installed")
    end)
end

task.spawn(function()
    for i = 1, 15 do
        task.wait(1)
        if not networkModule then
            pcall(function()
                networkModule = require(ReplicatedStorage.Modules.Network.Network)
            end)
        end
        if networkModule and not parryConn then
            installParryHook()
        end
        if parryConn then return end
    end
end)

task.delay(2, installParryHook)

-- ============================================================
-- BLOCK HANDLER
-- ============================================================
local lastBlock = 0

local function handleAutoBlock(killerModel, killerHRP)
    if not S.AutoBlock then return end
    if not killerHRP or not killerHRP.Parent then return end

    local our = getRoot(LocalPlayer.Character)
    if not our then return end

    local dist = (our.Position - killerHRP.Position).Magnitude
    if dist > S.BlockRange then return end

    if not isKillerFacingMe(our, killerHRP) then return end

    if os.clock() - lastBlock < 0.05 then return end
    if not blockReady() then return end
    lastBlock = os.clock()

    if S.Debug then
        print("[HB] BLOCK -> " .. killerModel.Name)
    end

    -- 1. Fire block
    fireBlock()

    -- 2. Aim
    if S.AimOnBlock then
        aimAt(killerHRP.Position)
    end

    -- 3. Punch (fallback parry, always fires)
    if S.PunchOnBlock then
        fallbackParry()
    end

    -- 4. HDT
    if S.HDT_Enabled and not hdtActive then
        startHDT(killerHRP)
    end

    -- 5. Safety auto-release
    task.delay((S.HDT_Duration or 1.0) + 0.2, function()
        if hdtActive then stopHDT() end
    end)
end

