local killerSoundCache = {}
local killerScanStatus = {}

local function getKillerSounds(killerModel)
    if not killerModel then return nil end
    if killerSoundCache[killerModel] then
        return killerSoundCache[killerModel]
    end

    if not findkillerid then
        killerSoundCache[killerModel] = {}
        killerScanStatus[killerModel] = "failed"
        return {}
    end

    local charName = killerModel:GetAttribute("CharacterName") or killerModel.Name
    local ok, result = pcall(findkillerid, "Killers", charName, M1_KEYWORDS)

    if ok and type(result) == "table" then
        killerSoundCache[killerModel] = result
        local count = 0
        for _ in pairs(result) do count += 1 end
        killerScanStatus[killerModel] = count > 0 and "ok" or "empty"
        print(string.format("[HB] %s -> %d M1 sound(s)", charName, count))
        return result
    else
        killerScanStatus[killerModel] = "failed"
        killerSoundCache[killerModel] = {}
        return {}
    end
end

