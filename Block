local cachedCooldown

local function refreshCooldownRef()
    local main = PlayerGui:FindFirstChild("MainUI")
    local ability = main and main:FindFirstChild("AbilityContainer")
    local btn = ability and ability:FindFirstChild("Block")
    cachedCooldown = btn and btn:FindFirstChild("CooldownTime")
end

local function blockReady()
    refreshCooldownRef()
    if not cachedCooldown or not cachedCooldown.Parent then return true end
    local t = cachedCooldown.Text
    if not t or t == "" then return true end
    local n = tonumber(t)
    if n == nil then return true end
    return n <= 0
end

