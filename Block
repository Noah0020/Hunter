-- AIM
-- ============================================================
local aimLockUntil, aimTargetPos = 0, nil
local aimConn = nil

local function releaseAim()
    if aimConn then aimConn:Disconnect(); aimConn = nil end
    aimLockUntil, aimTargetPos = 0, nil
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true end
end

local function aimAt(pos)
    if not pos then return end
    aimTargetPos = pos
    aimLockUntil = os.clock() + (S.AimHold or 0.30)
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = false end

    if not aimConn then
        aimConn = RunService.RenderStepped:Connect(function()
            if os.clock() > aimLockUntil then releaseAim() return end
            if not aimTargetPos then return end
            local c = LocalPlayer.Character
            local our = c and c:FindFirstChild("HumanoidRootPart")
            if not our then return end
            local flat = Vector3.new(aimTargetPos.X, our.Position.Y, aimTargetPos.Z)
            if (flat - our.Position).Magnitude > 0.1 then
                our.CFrame = CFrame.lookAt(our.Position, flat)
            end
            local cam = Workspace.CurrentCamera
            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, aimTargetPos) end
        end)
    end
end

-- ============================================================
-- HDT — 0.5s max, cancelled ONLY on parry success
-- ============================================================
local hdtActive = false
local hdtTarget = nil
local hdtBV = nil
local hdtConn = nil
local hdtTimerThread = nil
local hdtSavedWalk, hdtSavedJump, hdtSavedPlatform = nil, nil, nil

local function stopHDT()
    if not hdtActive then return end
    hdtActive = false
    hdtTarget = nil
    if hdtConn then hdtConn:Disconnect(); hdtConn = nil end
    if hdtTimerThread then task.cancel(hdtTimerThread); hdtTimerThread = nil end
    if hdtBV and hdtBV.Parent then pcall(function() hdtBV:Destroy() end) end
    hdtBV = nil
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:Move(Vector3.zero, false)
        if hdtSavedWalk then hum.WalkSpeed = hdtSavedWalk end
        if hdtSavedJump then hum.JumpPower = hdtSavedJump end
        if hdtSavedPlatform ~= nil then hum.PlatformStand = hdtSavedPlatform end
    end
    hdtSavedWalk, hdtSavedJump, hdtSavedPlatform = nil, nil, nil
    if S.Debug then print("[HB] HDT stopped") end
end

local function startHDT(targetHRP)
    if not S.HDT_Enabled then return end
    if not targetHRP or not targetHRP.Parent then return end
    hdtTarget = targetHRP
    if hdtActive then return end

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    hdtActive = true
    hdtSavedWalk = hum.WalkSpeed
    hdtSavedJump = hum.JumpPower
    hdtSavedPlatform = hum.PlatformStand

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.PlatformStand = false

    hdtBV = Instance.new("BodyVelocity")
    hdtBV.MaxForce = Vector3.new(1e5, 0, 1e5)
    hdtBV.Velocity = Vector3.zero
    hdtBV.Parent = hrp

    if S.HDT_Delay and S.HDT_Delay > 0 then task.wait(S.HDT_Delay) end

    hdtConn = RunService.Heartbeat:Connect(function()
        if not hdtActive then return end

        local c = LocalPlayer.Character
        if not c then stopHDT() return end
        local h = c:FindFirstChildOfClass("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if not h or not r or not hdtBV or not hdtBV.Parent then stopHDT() return end

        if not hdtTarget or not hdtTarget.Parent then stopHDT() return end

        local diff = hdtTarget.Position - r.Position
        local flat = Vector3.new(diff.X, 0, diff.Z)
        if flat.Magnitude < 0.1 then
            hdtBV.Velocity = Vector3.new(0, hdtBV.Velocity.Y, 0)
            return
        end
        local dir = flat.Unit
        hdtBV.Velocity = Vector3.new(dir.X * S.HDT_Speed, hdtBV.Velocity.Y, dir.Z * S.HDT_Speed)
    end)

    local dur = S.HDT_Duration or 0.5
    hdtTimerThread = task.delay(dur, function()
        if hdtActive then
            if S.Debug then print("[HB] HDT ran full " .. tostring(dur) .. "s — stopping") end
            stopHDT()
        end
    end)
end

-- ============================================================
-- PARRY — cancels HDT only on success
-- ============================================================
local networkModule, parryConn, lastParry = nil, nil, 0
task.spawn(function()
    pcall(function()
        networkModule = require(ReplicatedStorage.Modules.Network.Network)
    end)
end)

local function doParry()
    if not S.ParryEnabled then return end
    if os.clock() - lastParry < 0.15 then return end
    lastParry = os.clock()
    if (S.PunchDelay or 0) > 0 then task.wait(S.PunchDelay) end
    firePunch()
end

local function installParryHook()
    if parryConn or not networkModule then return end
    pcall(function()
        parryConn = networkModule:SetConnection(
            ("%*1337ParryIcon"):format(LocalPlayer.Name),
            "REMOTE_EVENT",
            function(blocked)
                if blocked == true then
                    -- PARRIED SUCCESSFULLY — cut HDT short
                    if hdtActive then
                        if S.Debug then print("[HB] parry success — cancelling HDT early") end
                        stopHDT()
                    end
                    doParry()
                end
                -- blocked == false → HDT keeps running until timer
            end
        )
    end)
end

task.spawn(function()
    for _ = 1, 15 do
        task.wait(1)
        if not networkModule then
            pcall(function()
                networkModule = require(ReplicatedStorage.Modules.Network.Network)
            end)
        end
        if networkModule and not parryConn then installParryHook() end
        if parryConn then return end
    end
end)

-- ============================================================
-- BLOCK HANDLER
-- ============================================================
local lastBlockTime = 0
local BLOCK_COOLDOWN = 0.15
local soundThrottle = {}

local function afterBlockSuccess(killerHRP, reason)
    if S.AimOnBlock then
        local predicted = killerHRP.Position
            + killerHRP.AssemblyLinearVelocity * (S.AimPrediction or 0.06)
        aimAt(predicted)
    end
    if S.ParryEnabled then doParry() end
    if S.HDT_Enabled then startHDT(killerHRP) end
end

local function tryBlock(killerModel, killerHRP, reason, soundKey, isSoundTrigger)
    if not S.AutoBlock then return false end
    if not killerHRP or not killerHRP.Parent then return false end

    local now = tick()
    if now - lastBlockTime < BLOCK_COOLDOWN then return false end
    if soundKey and soundThrottle[soundKey] and now < soundThrottle[soundKey] then return false end

    local our = getRoot(LocalPlayer.Character)
    if not our then return false end

    if not blockReady() then
        if S.Debug then print("[HB] skip: block cooldown") end
        return false
    end

    if not isSoundTrigger then
        if not inRange(our, killerHRP) then
            if S.Debug then print("[HB] skip: range") end
            return false
        end
        if not isFacing(our, killerHRP) then
            if S.Debug then print("[HB] skip: facing") end
            return false
        end
        if not hasLineOfSight(killerHRP) then
            if S.Debug then print("[HB] skip: LOS") end
            return false
        end
    end

    lastBlockTime = now
    if soundKey then soundThrottle[soundKey] = now + 0.5 end

    local ok = fireBlock()
    if S.Debug then
        print(string.format("[HB] BLOCK -> %s [%s] ok=%s",
            killerModel and killerModel.Name or "?", reason or "?", tostring(ok)))
    end

    afterBlockSuccess(killerHRP, reason)
    return ok
end

-- ============================================================
-- KILLER STATE (velocity tracking for prediction)
-- ============================================================
local killerState = {}
local SMOOTHING = 0.22
local PRED_SEC_FWD = 0.25
local PRED_SEC_LAT = 0.18
local PRED_MAX_FWD = 6
local PRED_MAX_LAT = 4
local ANG_TURN_MULT = 0.6

RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    local folder = getKillersFolder()
    if not folder then return end
    for _, killer in ipairs(folder:GetChildren()) do
        if killer:IsA("Model") then
            local hrp = killer:FindFirstChild("HumanoidRootPart")
            if hrp then
                local st = killerState[killer]
                if not st then
                    st = {
                        prevPos = hrp.Position,
                        prevLook = hrp.CFrame.LookVector,
                        vel = Vector3.zero,
                        angVel = 0,
                    }
                    killerState[killer] = st
                else
                    local newVel = (hrp.Position - st.prevPos) / math.max(dt, 1e-6)
                    st.vel = st.vel:Lerp(newVel, SMOOTHING)

                    local prevLook = st.prevLook or hrp.CFrame.LookVector
                    local look = hrp.CFrame.LookVector
                    local dot = math.clamp(prevLook:Dot(look), -1, 1)
                    local angle = math.acos(dot)
                    local crossY = prevLook:Cross(look).Y
                    local angSign = (crossY >= 0) and 1 or -1
                    local newAngVel = (angle / math.max(dt, 1e-6)) * angSign
                    st.angVel = st.angVel * (1 - SMOOTHING) + newAngVel * SMOOTHING

                    st.prevPos = hrp.Position
                    st.prevLook = look
                end
            end
        end
    end
end)

-- ============================================================
-- PREDICTIVE BLOCK
-- ============================================================
local predZones = {}

local function clearPredZones()
    for p in pairs(predZones) do
        if p and p.Parent then p:Destroy() end
    end
    predZones = {}
end

local function predictiveAttempt(killerModel)
    if not S.AutoBlock then return end
    if S.BlockMode ~= "Predictive" then return end
    if not killerModel or not killerModel.Parent then return end

    local killerHRP = killerModel:FindFirstChild("HumanoidRootPart")
    if not killerHRP then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    if not hasLineOfSight(killerHRP) then return end

    local st = killerState[killerModel]
        or { vel = killerHRP.AssemblyLinearVelocity or Vector3.zero, angVel = 0 }

    local vel = st.vel or Vector3.zero

    local forwardSpeed = vel:Dot(killerHRP.CFrame.LookVector)
    local lateralSpeed = vel:Dot(killerHRP.CFrame.RightVector)

    local forwardPredict = math.clamp(forwardSpeed * PRED_SEC_FWD, -PRED_MAX_FWD, PRED_MAX_FWD)
    local lateralPredict = math.clamp(lateralSpeed * PRED_SEC_LAT, -PRED_MAX_LAT, PRED_MAX_LAT)
    local turnLateral    = math.clamp(st.angVel * ANG_TURN_MULT, -PRED_MAX_LAT, PRED_MAX_LAT)

    local basePartSize = Vector3.new(5.5, 7.5, 8.5) * (S.PredSizeMult or 1)
    local count = math.max(1, S.PredParts or 4)
    local base  = S.PredBaseOffset or 2.7
    local step  = S.PredOffsetStep or 0.2

    task.spawn(function()
        task.wait(S.PredDelay or 0)
        local hit = false
        for i = 1, count do
            if not killerHRP or not killerHRP.Parent then break end
            local c = LocalPlayer.Character
            if not c then break end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then break end

            local dist = base + (i - 1) * step
            local forwardDist = dist + forwardPredict

            local spawnPos = killerHRP.Position
                + killerHRP.CFrame.LookVector * forwardDist
                + killerHRP.CFrame.RightVector * (lateralPredict + turnLateral)

            local part = Instance.new("Part")
            part.Name = "HB_PredZone"
            part.Size = basePartSize
            part.Anchored = true
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.Transparency = S.ShowPredParts and 0.5 or 1
            part.Material = Enum.Material.ForceField
            part.Color = Color3.fromRGB(0, 170, 255)
            part.CFrame = CFrame.new(spawnPos, killerHRP.Position)
            part.Parent = Workspace
            predZones[part] = true
            Debris:AddItem(part, 0.2)

            if isPointInsidePart(part, r.Position) then
                hit = true
            else
                local touching = {}
                pcall(function() touching = r:GetTouchingParts() end)
                for _, p in ipairs(touching) do
                    if p == part then hit = true break end
                end
            end

            if hit then
                if not (S.WallCheck and not hasLineOfSight(killerHRP)) then
                    tryBlock(killerModel, killerHRP, "PRED", nil, false)
                end
                break
            end

            if (S.PredStagger or 0) > 0 then
                task.wait(S.PredStagger)
            else
                task.wait()
            end
        end
    end)
end

