-- HELPERS
-- ============================================================
local function getRoot(m)
    return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function getKillersFolder()
    local p = Workspace:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end

local function getKillers()
    local f = getKillersFolder()
    if not f then return {} end
    local t = {}
    for _, c in ipairs(f:GetChildren()) do
        if c:IsA("Model") then t[#t+1] = c end
    end
    return t
end

local function getKillerHRP(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart", true)
end

local function getNearestKiller()
    local our = getRoot(LocalPlayer.Character)
    if not our then return nil end
    local best, bestD = nil, 999
    for _, k in ipairs(getKillers()) do
        local hrp = getKillerHRP(k)
        local hum = k:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local d = (hrp.Position - our.Position).Magnitude
            if d < bestD then bestD, best = d, k end
        end
    end
    return best
end

-- ============================================================
-- FACING CHECK
-- ============================================================
local function isKillerFacingMe(ourRoot, killerRoot, threshold)
    threshold = threshold or S.FacingThreshold or 0.0
    if not ourRoot or not killerRoot then return false end

    local dx = ourRoot.Position.X - killerRoot.Position.X
    local dy = ourRoot.Position.Y - killerRoot.Position.Y
    local dz = ourRoot.Position.Z - killerRoot.Position.Z

    local mag = math.sqrt(dx*dx + dy*dy + dz*dz)
    if mag < 0.001 then return true end
    local inv = 1 / mag

    local ux, uy, uz = dx * inv, dy * inv, dz * inv
    local lv = killerRoot.CFrame.LookVector

    local dot = lv.X * ux + lv.Y * uy + lv.Z * uz
    return dot >= threshold
end

-- ============================================================
-- AIM (with AutoRotate lock + short hold)
-- ============================================================
local aimLockUntil = 0
local aimTargetPos = nil

local function aimAt(targetPos)
    if not targetPos then return end
    aimTargetPos = targetPos
    aimLockUntil = os.clock() + (S.AimHold or 0.35)

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.AutoRotate = false
    end
end

RunService.RenderStepped:Connect(function()
    if os.clock() > aimLockUntil then
        if aimLockUntil ~= 0 then
            aimLockUntil = 0
            aimTargetPos = nil
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.AutoRotate = true end
        end
        return
    end

    if not aimTargetPos then return end
    local char = LocalPlayer.Character
    if not char then return end
    local our = char:FindFirstChild("HumanoidRootPart")
    if not our then return end

    local mode = S.AimMode or "HRP + Camera"

    if mode == "HRP" or mode == "HRP + Camera" then
        local flat = Vector3.new(aimTargetPos.X, our.Position.Y, aimTargetPos.Z)
        if (flat - our.Position).Magnitude > 0.1 then
            our.CFrame = CFrame.lookAt(our.Position, flat)
        end
    end

    if mode == "Camera" or mode == "HRP + Camera" then
        if Camera then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, aimTargetPos)
        end
    end
end)

