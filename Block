-- REACH
-- ============================================================
local reachOrigSizes = {}

local function applyReach()
    if not S.Reach then return end
    local char = LocalPlayer.Character
    if not char then return end

    for _, name in ipairs({
        "RightHand", "LeftHand", "Handle",
        "Hitbox", "CollisionHitbox", "QueryHitbox",
        "Weapon", "Sword", "Blade", "Punch"
    }) do
        local p = char:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then
            if not reachOrigSizes[p] then
                reachOrigSizes[p] = p.Size
            end
            local sz = S.ReachSize or 4
            p.Size = Vector3.new(sz, sz, sz)
            p.Massless = true
            p.CanCollide = false
        end
    end
end

local function clearReach()
    for p, orig in pairs(reachOrigSizes) do
        if p and p.Parent then
            pcall(function() p.Size = orig end)
        end
    end
    reachOrigSizes = {}
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if S.Reach then
            applyReach()
        elseif next(reachOrigSizes) then
            clearReach()
        end
    end
end)

-- ============================================================
-- HDT
-- ============================================================
local hdtActive = false
local hdtTargetHRP = nil
local hdtEndTime = 0

local function getHDTMaxSpeed()
    return S.HDT_Mode == "Blatant" and 50 or 25
end

local function startHDT(hrp)
    if not S.HDT_Enabled then return end
    if hdtActive then return end
    if not hrp or not hrp.Parent then return end

    if S.HDT_Speed > getHDTMaxSpeed() then
        S.HDT_Speed = getHDTMaxSpeed()
    end

    hdtActive = true
    hdtTargetHRP = hrp
    hdtEndTime = os.clock() + (S.HDT_Duration or 1.0)
end

local function stopHDT()
    if not hdtActive then return end
    hdtActive = false
    hdtTargetHRP = nil
    hdtEndTime = 0

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    end
end

RunService.Heartbeat:Connect(function()
    if not hdtActive then return end

    if os.clock() > hdtEndTime then stopHDT() return end
    if not hdtTargetHRP or not hdtTargetHRP.Parent then stopHDT() return end

    local char = LocalPlayer.Character
    if not char then stopHDT() return end
    local our = char:FindFirstChild("HumanoidRootPart")
    if not our then stopHDT() return end

    local diff = hdtTargetHRP.Position - our.Position
    local dist = diff.Magnitude

    if dist < 2.5 then
        stopHDT()
        return
    end

    local dir = diff.Unit
    local speed = math.min(S.HDT_Speed, getHDTMaxSpeed())

    if S.HDT_Mode == "Legit" then
        our.AssemblyLinearVelocity = dir * speed
    else
        local shake = Vector3.new(
            math.random(-50, 50) / 50,
            math.random(-50, 50) / 50,
            math.random(-50, 50) / 50
        )
        our.AssemblyLinearVelocity = dir * (speed + dist * 5) + shake
    end
end)

