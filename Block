local testRemote
task.spawn(function()
    pcall(function()
        testRemote = ReplicatedStorage:WaitForChild("Modules", 15)
            :WaitForChild("Network", 8)
            :WaitForChild("Network", 8)
            :WaitForChild("RemoteEvent", 8)
    end)
end)

local function getRemote()
    if testRemote and testRemote.Parent then return testRemote end
    pcall(function()
        testRemote = ReplicatedStorage.Modules.Network.Network.RemoteEvent
    end)
    return testRemote
end

local function fireAbility(name)
    local re = getRemote()
    if not re then return false end
    local bytes = {3}
    local len = #name
    bytes[2] = len; bytes[3] = 0; bytes[4] = 0; bytes[5] = 0
    for i = 1, len do bytes[5 + i] = string.byte(name, i) end
    local b = buffer.create(#bytes)
    for i = 1, #bytes do buffer.writeu8(b, i - 1, bytes[i]) end
    return pcall(function() re:FireServer("UseActorAbility", { b }) end)
end

local fireBlock = function() return fireAbility("Block") end
local firePunch = function() return fireAbility("Punch") end

