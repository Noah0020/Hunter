                    for _ in pairs(cache) do count = count + 1 end
                end
                table.insert(lines, string.format("  %s", k.Name))
                table.insert(lines, string.format("    CharName: %s", charName))
                table.insert(lines, string.format("    Scan: %s | Sounds: %d", status, count))
            end
        end

        table.insert(lines, "")
        table.insert(lines, "[ CONFIG ]")
        table.insert(lines, "  AutoBlock:   " .. (S.AutoBlock and "ON" or "OFF"))
        table.insert(lines, "  Aim:         " .. (S.AimOnBlock and "ON" or "OFF") .. " | " .. S.AimMode)
