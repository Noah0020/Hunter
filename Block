        table.insert(lines, "  HDT:         " .. (S.HDT_Enabled and "ON" or "OFF") .. " | " .. S.HDT_Mode)
        table.insert(lines, "  HDT Speed:   " .. math.floor(S.HDT_Speed))
        table.insert(lines, "  HDT Duration:" .. string.format("%.2f", S.HDT_Duration))
        table.insert(lines, "  HDT Running: " .. (hdtActive and "YES" or "no"))
        table.insert(lines, "  Range:       " .. math.floor(S.BlockRange))
        table.insert(lines, "  Facing:      " .. string.format("%.2f", S.FacingThreshold))

        diagLabel.Text = table.concat(lines, "\n")
    end
end)

