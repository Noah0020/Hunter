-- ============================================================
local soundHooks = setmetatable({}, { __mode = "k" })

local function extractId(sound)
    return tostring(sound.SoundId):match("%d+")
end

local function findKillerForInstance(inst)
    local p = inst
    while p and p ~= Workspace do
        if p:IsA("Model") then
            local parent = p.Parent
            if parent and parent.Name == "Killers" then return p end
            if p:FindFirstChildOfClass("Humanoid") then return p end
        end
        p = p.Parent
    end
    return nil
end

local function onSoundFired(sound)
    if not S.AutoBlock then return end
    if not sound.IsPlaying then return end
    local id = extractId(sound)
    if not id or not SOUND_DB[id] then return end

    local killer = findKillerForInstance(sound.Parent)
    if not killer then return end
    local hrp = getKillerHRP(killer)
    if not hrp then return end

    if S.BlockMode == "Predictive" then
        predictiveAttempt(killer)
    else
        tryBlock(killer, hrp, "SOUND:" .. id, sound, true)
    end
end

local function hookSound(sound)
    if not sound or not sound:IsA("Sound") or soundHooks[sound] then return end
    soundHooks[sound] = true
    sound.Played:Connect(function() onSoundFired(sound) end)
    sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then onSoundFired(sound) end
    end)
    if sound.IsPlaying then task.defer(function() onSoundFired(sound) end) end
end

-- ============================================================
-- ANIM HOOKS
-- ============================================================
local animHooks = setmetatable({}, { __mode = "k" })

local function onAnimPlayed(animator, track)
    if not S.AutoBlock then return end
    if not track or not track.Animation then return end
    local id = tostring(track.Animation.AnimationId):match("%d+")
    if not id or not ANIM_DB[id] then return end

    local killer = findKillerForInstance(animator.Parent)
    if not killer then return end
    local hrp = getKillerHRP(killer)
    if not hrp then return end

    if S.BlockMode == "Predictive" then
        local timePos = 0
        pcall(function() timePos = track.TimePosition or 0 end)
        if timePos <= 0.12 then
            predictiveAttempt(killer)
        end
    else
        tryBlock(killer, hrp, "ANIM:" .. id)
    end
end

local function hookAnimator(animator)
    if not animator or not animator:IsA("Animator") or animHooks[animator] then return end
    animHooks[animator] = true
    animator.AnimationPlayed:Connect(function(track) onAnimPlayed(animator, track) end)
end

-- ============================================================
-- KILLER TRACKING
-- ============================================================
local tracked = setmetatable({}, { __mode = "k" })

local function trackKiller(killer)
    if not killer or not killer:IsA("Model") or tracked[killer] then return end
    tracked[killer] = true
    for _, d in ipairs(killer:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d)
        elseif d:IsA("Animator") then hookAnimator(d) end
    end
    killer.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then task.defer(function() hookSound(d) end)
        elseif d:IsA("Animator") then task.defer(function() hookAnimator(d) end) end
    end)
end

local function scanAll()
    local folder = getKillersFolder()
    if not folder then return end
    for _, k in ipairs(folder:GetChildren()) do
        if k:IsA("Model") then trackKiller(k) end
    end
end

task.spawn(function()
    while not getKillersFolder() do task.wait(1) end
    scanAll()
    getKillersFolder().ChildAdded:Connect(function(k)
        if k:IsA("Model") then task.defer(function() trackKiller(k) end) end
    end)
end)

