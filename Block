-- VISUALS
-- ============================================================
local rangeVisuals = {}
local coneVisuals = {}
local visualConn = nil

local function makeAdornment(hrp, radius, color, yOffset)
    local a = Instance.new("CylinderHandleAdornment")
    a.Adornee = hrp
    a.AlwaysOnTop = true
    a.ZIndex = 2
    a.Color3 = color
    a.Transparency = 0.55
    a.Radius = radius
    a.Height = 0.12
    a.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), 0, 0)
    a.Parent = hrp
    return a
end

local function ensureRangeVisual(killer, hrp)
    if rangeVisuals[killer] and rangeVisuals[killer].Parent then return rangeVisuals[killer] end
    local yOffset = -(hrp.Size.Y / 2 + 0.05)
    local a = makeAdornment(hrp, S.BlockRange, Color3.fromRGB(255, 255, 0), yOffset)
    rangeVisuals[killer] = a
    return a
end

local function ensureConeVisual(killer, hrp)
    if coneVisuals[killer] and coneVisuals[killer].Parent then return coneVisuals[killer] end
    local yOffset = -(hrp.Size.Y / 2 + 0.05)
    local a = makeAdornment(hrp, S.BlockRange * 0.5, Color3.fromRGB(255, 0, 0), yOffset)
    coneVisuals[killer] = a
    return a
end

local function destroyVisuals(killer)
    if rangeVisuals[killer] then rangeVisuals[killer]:Destroy(); rangeVisuals[killer] = nil end
    if coneVisuals[killer] then coneVisuals[killer]:Destroy(); coneVisuals[killer] = nil end
end

local function clearAllVisuals()
    for k in pairs(rangeVisuals) do destroyVisuals(k) end
end

local function startVisualLoop()
    if visualConn then return end
    visualConn = RunService.RenderStepped:Connect(function()
        if not (S.ShowBlockCone or S.ShowRangeCircle) then return end
        local folder = getKillersFolder()
        if not folder then return end

        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")

        for _, killer in ipairs(folder:GetChildren()) do
            if killer:IsA("Model") then
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local yOffset = -(hrp.Size.Y / 2 + 0.05)
                    local inR = myRoot and (hrp.Position - myRoot.Position).Magnitude <= S.BlockRange

                    if S.ShowRangeCircle then
                        local a = ensureRangeVisual(killer, hrp)
                        a.Radius = S.BlockRange
                        a.CFrame = CFrame.new(0, yOffset, 0) * CFrame.Angles(math.rad(90), 0, 0)
                        a.Color3 = inR and Color3.fromRGB(255, 165, 0) or Color3.fromRGB(255, 255, 0)
                    elseif rangeVisuals[killer] then
                        rangeVisuals[killer]:Destroy(); rangeVisuals[killer] = nil
                    end

                    if S.ShowBlockCone then
                        local a = ensureConeVisual(killer, hrp)
                        local dot = math.clamp(S.FacingDot or 0.3, -1, 1)
                        local angle = math.acos(dot)
                        local frac = angle / math.pi
                        local minFrac = 0.20
                        local radius = math.max(1, S.BlockRange * (minFrac + (1 - minFrac) * frac))
                        local forwardDist = S.BlockRange * (0.35 + 0.15 * frac)
                        a.Radius = radius
                        a.CFrame = CFrame.new(0, yOffset, -forwardDist) * CFrame.Angles(math.rad(90), 0, 0)
                        a.Color3 = inR and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(255, 255, 0)
                    elseif coneVisuals[killer] then
                        coneVisuals[killer]:Destroy(); coneVisuals[killer] = nil
                    end
                end
            end
        end
    end)
end

