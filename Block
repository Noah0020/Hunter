-- ============================================================
-- FACING
-- ============================================================
local function isFacing(myRoot, targetHRP)
    if not myRoot or not targetHRP then return false end
    local d = myRoot.Position - targetHRP.Position
    local mag = d.Magnitude
    if mag < 3 then return true end
    local u = d / mag
    local lv = targetHRP.CFrame.LookVector
    return lv:Dot(u) > (S.FacingDot or 0.3)
end

local function inRange(myRoot, targetHRP)
    if not myRoot or not targetHRP then return false end
    return (myRoot.Position - targetHRP.Position).Magnitude <= (S.BlockRange or 18)
end

local function hasLineOfSight(targetHRP)
    if not S.WallCheck then return true end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetHRP then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local killerModel = targetHRP:FindFirstAncestorOfClass("Model")
    local excl = { char }
    if killerModel then table.insert(excl, killerModel) end
    params.FilterDescendantsInstances = excl
    params.IgnoreWater = true
    local hit = Workspace:Raycast(myRoot.Position, targetHRP.Position - myRoot.Position, params)
    return hit == nil
end

local function isPointInsidePart(part, point)
    if not (part and point) then return false end
    local rel = part.CFrame:PointToObjectSpace(point)
    local half = part.Size * 0.5
    return math.abs(rel.X) <= half.X + 0.001
       and math.abs(rel.Y) <= half.Y + 0.001
       and math.abs(rel.Z) <= half.Z + 0.001
end

