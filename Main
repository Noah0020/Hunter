local TRIGGER_ANIMS_SET = {}
for _, id in ipairs(TRIGGER_ANIMS) do TRIGGER_ANIMS_SET[id] = true end

local hookedSounds = {}

local function onSoundTrigger(sound)
    local id = extractSoundId(sound)
    if not id or not TRIGGER_SOUNDS[id] then return end
    local ancestor = sound:FindFirstAncestorOfClass("Model")
    if not ancestor or ancestor.Parent ~= KillersFolder then return end

    -- ----- FIRE BLOCK FIRST -----
    if CFG.AutoBlockEnabled and CFG.SoundTrigger then
        local killerRoot = ancestor:FindFirstChild("HumanoidRootPart")
        if killerRoot and shouldBlock(killerRoot) then
            if CFG.BlockDelay > 0 then
                task.delay(CFG.BlockDelay, fireBlock)
            else
                fireBlock()   -- same-frame, synchronous
            end
        end
    end

    -- ----- Side effects AFTER the block packet is already sent -----
    if FacingVisual and FacingVisual.FlashKiller then
        FacingVisual.FlashKiller(ancestor)
    end
end

local function hookSound(sound)
    if hookedSounds[sound] then return end
    hookedSounds[sound] = true
    local c1 = sound.Played:Connect(function() onSoundTrigger(sound) end)
    local c2 = sound:GetPropertyChangedSignal("IsPlaying"):Connect(function()
        if sound.IsPlaying then onSoundTrigger(sound) end
    end)
    sound.Destroying:Once(function()
        hookedSounds[sound] = nil
        pcall(function() c1:Disconnect() end)
        pcall(function() c2:Disconnect() end)
    end)
    if sound.IsPlaying then onSoundTrigger(sound) end
end

if KillersFolder then
    for _, d in ipairs(KillersFolder:GetDescendants()) do
        if d:IsA("Sound") then hookSound(d) end
    end
    KillersFolder.DescendantAdded:Connect(function(d)
        if d:IsA("Sound") then hookSound(d) end
    end)
end

local hookedAnims = {}

local function onAnimPlayed(killerModel, track)
    local animId = track.Animation and tostring(track.Animation.AnimationId):match("(%d+)")
    if not animId or not TRIGGER_ANIMS_SET[animId] then return end

    -- ----- FIRE BLOCK FIRST -----
    if CFG.AutoBlockEnabled and CFG.AnimTrigger then
        local killerRoot = killerModel:FindFirstChild("HumanoidRootPart")
        if killerRoot and shouldBlock(killerRoot) then
            if CFG.BlockDelay > 0 then
                task.delay(CFG.BlockDelay, fireBlock)
            else
                fireBlock()
            end
        end
    end

    -- ----- Side effects after -----
    if FacingVisual and FacingVisual.FlashKiller then
        FacingVisual.FlashKiller(killerModel)
    end
end

local function hookKiller(killerModel)
    if not killerModel:IsA("Model") then return end
    if hookedAnims[killerModel] then return end

    local waitConns = {}
    local function disconnectWaiters()
        for _, c in ipairs(waitConns) do pcall(function() c:Disconnect() end) end
        waitConns = {}
    end

    local animConn
    local function tryHook()
        if hookedAnims[killerModel] then return true end
        if not killerModel.Parent then return false end
        local humanoid = killerModel:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then return false end
        hookedAnims[killerModel] = true
        animConn = animator.AnimationPlayed:Connect(function(track)
            onAnimPlayed(killerModel, track)
        end)
        killerModel.Destroying:Once(function()
            hookedAnims[killerModel] = nil
            disconnectWaiters()
            if animConn then pcall(function() animConn:Disconnect() end) end
        end)
        disconnectWaiters()
        return true
    end

    if tryHook() then return end

    waitConns[#waitConns + 1] = killerModel.ChildAdded:Connect(function()
        if tryHook() then disconnectWaiters() end
    end)
    waitConns[#waitConns + 1] = killerModel.DescendantAdded:Connect(function(d)
        if d:IsA("Animator") then
            if tryHook() then disconnectWaiters() end
        end
    end)
    task.delay(3, function()
        if not hookedAnims[killerModel] then tryHook() end
        disconnectWaiters()
    end)
end

if KillersFolder then
    for _, k in ipairs(KillersFolder:GetChildren()) do hookKiller(k) end
    KillersFolder.ChildAdded:Connect(hookKiller)
end

-- =========================================================
-- HDT (27s global cooldown, no manual trigger)
-- =========================================================
HDT = {
    Enabled = false, AutoTrigger = true, Speed = 10, Delay = 0,
    StopDistance = 2, SafetyTimeout = 1.5,
    Cooldown = 27,
    _dragId = 0, _dragging = false, _conn = nil, _saved = nil,
    _lastFire = 0, _fireDebounce = 0.15,
    _nextAllowed = 0,
}

local function startDrag(targetPart)
    if not targetPart or not targetPart.Parent then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    local startDist = (targetPart.Position - hrp.Position).Magnitude
    if startDist <= HDT.StopDistance + 0.5 then return end

    HDT._dragId += 1
    local myId = HDT._dragId
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end

    HDT._dragging = true
    local saved = {
        walk = humanoid.WalkSpeed,
        jump = humanoid.JumpPower,
        autoRotate = humanoid.AutoRotate,
    }
    HDT._saved = saved
    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false

    local finished = false
    local function cleanup()
        if finished then return end
        finished = true
        if HDT._dragId ~= myId then return end
        HDT._dragging = false
        if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if humanoid and humanoid.Parent then
            pcall(function()
                humanoid.WalkSpeed = saved.walk
                humanoid.JumpPower = saved.jump
                humanoid.AutoRotate = saved.autoRotate
            end)
        end
        HDT._saved = nil
    end

    HDT._conn = RunService.Heartbeat:Connect(function(dt)
        if HDT._dragId ~= myId or not HDT._dragging then
            cleanup(); return
        end
        if not (char and char.Parent and targetPart and targetPart.Parent) then
            cleanup(); return
        end

        local myPos = hrp.Position
        local tgtPos = targetPart.Position
        local flat = Vector3.new(tgtPos.X, myPos.Y, tgtPos.Z)
        local delta = flat - myPos
        local dist = delta.Magnitude

        if dist <= HDT.StopDistance then cleanup(); return end

        local maxStep = HDT.Speed * dt
        local step = math.min(maxStep, dist - HDT.StopDistance)
        if step <= 0 then cleanup(); return end

        local newPos = myPos + delta.Unit * step
        hrp.CFrame = CFrame.lookAt(newPos, flat)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    task.delay(HDT.SafetyTimeout, function()
        if HDT._dragId == myId and HDT._dragging then cleanup() end
    end)
end

function HDT.TriggerFromAutoBlock(force)
    if not force and not HDT.Enabled then return end
    if HDT._dragging then return end
    if tick() < (HDT._nextAllowed or 0) then return end
    if tick() - HDT._lastFire < HDT._fireDebounce then return end

    local target = nearestKillerPart()
    if not target then return end

    local myRoot = getMyRoot()
    if myRoot then
        local d = (target.Position - myRoot.Position).Magnitude
        if d <= HDT.StopDistance + 0.5 then return end
    end

    HDT._lastFire = tick()
    HDT._nextAllowed = tick() + (HDT.Cooldown or 27)

    if HDT.Delay > 0 then
        task.delay(HDT.Delay, function() startDrag(target) end)
    else
        startDrag(target)
    end
end

lp.CharacterAdded:Connect(function()
    HDT._dragId += 1
    HDT._dragging = false
    if HDT._conn then HDT._conn:Disconnect() HDT._conn = nil end
    HDT._saved = nil
end)

-- =========================================================
-- AIM
-- =========================================================
AIM = {
    Enabled     = false,
    AimMode     = "Camera",
    Smooth      = 0.35,
    PredictMode = "Both",
    PredictLead = 0.15,
    PingMult    = 1.0,
    Debug       = false,
    CurrentAbility  = nil,
    CachedTargetHRP = nil,
    _aimUntil  = 0,
}

local PING_ABILITIES = { AimGun = true, GunFire = true, GunExplode = true, GunFail = true }

local function getPing()
    local ok, v = pcall(function() return lp:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 end)
    if ok and type(v) == "number" then return v end
    return 0
end

local function getMyRole()
    local c = lp.Character
    local p = c and c.Parent
    if p and (p.Name == "Survivors" or p.Name == "Killers") then return p.Name end
    return nil
end

local function isPlayingSurvivor()
    if getMyRole() ~= "Survivors" then return false end
    local char = lp.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function updateCachedTarget()
    local myRoot = getRoot(lp.Character)
    if not myRoot or not KillersFolder then AIM.CachedTargetHRP = nil return end
    local best, bestD = nil, 500
    for _, s in ipairs(KillersFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character then
            local hrp = s:FindFirstChild("HumanoidRootPart")
            local hum = s:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestD then bestD = d; best = hrp end
            end
        end
    end
    AIM.CachedTargetHRP = best
end

task.spawn(function()
    while true do
        task.wait(0.1)
        pcall(updateCachedTarget)
    end
end)

local function isPingAbility(abilityName)
    return abilityName and PING_ABILITIES[abilityName] == true
end

local function predictHRP(hrp)
    if not hrp then return nil end
    if AIM.PredictMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.zero end
    local usePing = isPingAbility(AIM.CurrentAbility)
    local velLead  = 0
    local pingLead = 0
    if AIM.PredictMode == "Velocity" or AIM.PredictMode == "Both" then
        velLead = AIM.PredictLead
    end
    if usePing and (AIM.PredictMode == "Ping" or AIM.PredictMode == "Both") then
        local ping = getPing() * 0.5 * AIM.PingMult
        pingLead = math.clamp(ping, 0, 0.5)
    end
    local totalLead = math.clamp(velLead + pingLead, 0, 0.75)
    return hrp.Position + vel * totalLead
end

function AIM.AimFor(duration, abilityName)
    AIM._aimUntil = tick() + (duration or 1.0)
    if abilityName then AIM.CurrentAbility = abilityName end
end

local hrpAutoRotateSaved = nil
local function restoreAutoRotate()
    if hrpAutoRotateSaved == nil then return end
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = hrpAutoRotateSaved end
    hrpAutoRotateSaved = nil
end
local function disableAutoRotate()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hrpAutoRotateSaved == nil then hrpAutoRotateSaved = hum.AutoRotate end
    hum.AutoRotate = false
end

lp.CharacterAdded:Connect(function()
    hrpAutoRotateSaved = nil
end)

RunService:BindToRenderStep("HunterAim", Enum.RenderPriority.Camera.Value + 1, function()
    if not isPlayingSurvivor() then
        restoreAutoRotate()
        return
    end

    local active = AIM.Enabled or (tick() < (AIM._aimUntil or 0))

    if not active
       or not AIM.CachedTargetHRP
       or not AIM.CachedTargetHRP.Parent then
        AIM.CurrentAbility = nil
        restoreAutoRotate()
        return
    end

    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        restoreAutoRotate()
        return
    end

    local targetPos = predictHRP(AIM.CachedTargetHRP)
    if not targetPos then return end

    local mode = AIM.AimMode
    local smooth = AIM.Smooth

    if mode == "Camera" or mode == "HRP+Camera" then
        local desired = CFrame.lookAt(Camera.CFrame.Position, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(desired, smooth)
    end

    if mode == "HRP" or mode == "HRP+Camera" then
        disableAutoRotate()
        local flat = Vector3.new(targetPos.X, myRoot.Position.Y, targetPos.Z)
        local delta = flat - myRoot.Position
        if delta.Magnitude > 0.05 then
            local desired = CFrame.lookAt(myRoot.Position, flat)
            myRoot.CFrame = myRoot.CFrame:Lerp(desired, smooth)
        end
    else
        restoreAutoRotate()
    end
end)

-- =========================================================
-- ability button hook
-- =========================================================
AbilityHook = {
    Enabled = true,

    StunAbilities = {
        Chance     = { Button = "Shoot",   Lock = 1.20, Ability = "AimGun" },
        Shedletsky = { Button = "Slash",   Lock = 0.80, Ability = "Slash" },
        TwoTime    = { Button = "Dagger",  Lock = 0.50, Ability = "Stab" },
        Guest1337  = { Button = "Punch",   Lock = 0.90, Ability = "Punch" },
        JaneDoe    = { Button = "Hatchet", Lock = 0.95, Ability = "Axe" },
    },

    LockMultiplier = 1.0,
    Cooldown       = 1.0,
    _lastFire      = 0,

    Hooked   = {},
    LastTap  = {},
    Debounce = 0.05,
    _uiWatcher = nil,

    _pendingFire   = nil,
    PendingWindow  = 0.35,
    _animConn      = nil,
}

local ABILITY_KEYWORDS = {
    Chance     = { "shoot", "gun", "oneshot", "one shot", "flint", "pistol", "revolver" },
    Shedletsky = { "slash", "sword" },
    TwoTime    = { "dagger", "stab", "knife" },
    Guest1337  = { "punch", "fist" },
    JaneDoe    = { "hatchet", "axe" },
}

local function ahResolveForChar()
    local c = lp.Character
    if not c then return nil end
    local rawName = c:GetAttribute("CharacterName") or c.Name
    if not rawName then return nil end
    local normalized = string.lower(tostring(rawName)):gsub("[%s_%-]", "")
    for key, cfg in pairs(AbilityHook.StunAbilities) do
        local kNorm = string.lower(key):gsub("[%s_%-]", "")
        if kNorm == normalized then
            return { key = key, cfg = cfg, kws = ABILITY_KEYWORDS[key] }
        end
    end
    return nil
end

local function ahIsConfirmedPriority(prio)
    return prio == Enum.AnimationPriority.Action
        or prio == Enum.AnimationPriority.Action2
        or prio == Enum.AnimationPriority.Action3
        or prio == Enum.AnimationPriority.Action4
end

local function ahFireConfirmed(cfg)
    if not AbilityHook.Enabled then return end
    if not cfg then return end
    local now = tick()
    if now - (AbilityHook._lastFire or 0) < (AbilityHook.Cooldown or 1.0) then return end
    AbilityHook._lastFire = now
    if AIM then
        local dur = (cfg.Lock or 0.6) * (AbilityHook.LockMultiplier or 1.0)
        AIM.AimFor(dur, cfg.Ability)
    end
end

local function ahBindAnimator(char, attempt)
    attempt = attempt or 1
    if AbilityHook._animConn then
        pcall(function() AbilityHook._animConn:Disconnect() end)
        AbilityHook._animConn = nil
    end
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then
        if attempt < 5 then
            task.delay(0.4, function()
                if lp.Character == char and AbilityHook.Enabled then
                    ahBindAnimator(char, attempt + 1)
                end
            end)
        end
        return
    end
    AbilityHook._animConn = animator.AnimationPlayed:Connect(function(track)
        if lp.Character ~= char then return end
        local pending = AbilityHook._pendingFire
        if not pending then return end
        if tick() - pending.ts > (AbilityHook.PendingWindow or 0.35) then
            AbilityHook._pendingFire = nil
            return
        end
        local a = track and track.Animation
        if not a then return end
        local id = tostring(a.AnimationId):match("%d+")
        if not id then return end
        if not ahIsConfirmedPriority(track.Priority) then return end
        AbilityHook._pendingFire = nil
        ahFireConfirmed(pending.cfg)
    end)
end

local function ahFireButtonAim(btn, cfg)
    if not AbilityHook.Enabled then return end
    if not cfg then return end
    local now = tick()
    local last = AbilityHook.LastTap[btn]
    if last and now - last < AbilityHook.Debounce then return end
    AbilityHook.LastTap[btn] = now
    AbilityHook._pendingFire = { cfg = cfg, ts = now }
end

local function ahHookButton(btn, cfg)
    if not btn or AbilityHook.Hooked[btn] then return end
    if not btn:IsA("GuiButton") then return end
    AbilityHook.Hooked[btn] = true

    local function fire() ahFireButtonAim(btn, cfg) end

    pcall(function() btn.Activated:Connect(fire) end)
    pcall(function()
        btn.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end
            local pos = input.Position
            local abs = btn.AbsolutePosition
            local size = btn.AbsoluteSize
            if pos.X < abs.X or pos.X > abs.X + size.X
               or pos.Y < abs.Y or pos.Y > abs.Y + size.Y then
                return
            end
            fire()
        end)
    end)
end

local function ahButtonMatches(btn, cfg, kws)
    if btn.Name == cfg.Button then return true end
    if not kws then return false end
    local blobs = { string.lower(tostring(btn.Name or "")) }
    if btn:IsA("TextButton") or btn:IsA("TextLabel") then
        blobs[#blobs + 1] = string.lower(tostring(btn.Text or ""))
    end
    for _, d in ipairs(btn:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") then
            blobs[#blobs + 1] = string.lower(tostring(d.Text or ""))
            blobs[#blobs + 1] = string.lower(tostring(d.Name or ""))
        end
    end
    for _, blob in ipairs(blobs) do
        for _, kw in ipairs(kws) do
            if blob:find(kw, 1, true) then return true end
        end
    end
    return false
end

local function ahScanContainer()
    if not AbilityHook.Enabled then return end
    local info = ahResolveForChar()
    if not info then return end
    local cfg, kws = info.cfg, info.kws
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return end

    local main = pg:FindFirstChild("MainUI")
    if not main then return end
    local container = main:FindFirstChild("AbilityContainer")

    local function try(btn)
        if btn:IsA("GuiButton") and ahButtonMatches(btn, cfg, kws) then
            ahHookButton(btn, cfg)
        end
    end

    if container then
        for _, c in ipairs(container:GetChildren()) do try(c) end
        return
    end
    for _, d in ipairs(main:GetDescendants()) do
        if d:IsA("GuiButton") then try(d) end
    end
end

local function ahInstallUiWatcher()
    if AbilityHook._uiWatcher then
        pcall(function() AbilityHook._uiWatcher:Disconnect() end)
        AbilityHook._uiWatcher = nil
    end
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return end
    AbilityHook._uiWatcher = pg.DescendantAdded:Connect(function(d)
        if not AbilityHook.Enabled then return end
        if not d:IsA("GuiButton") then return end
        local info = ahResolveForChar()
        if not info then return end
        if ahButtonMatches(d, info.cfg, info.kws) then
            ahHookButton(d, info.cfg)
        end
    end)
end

lp.CharacterAdded:Connect(function(char)
    AbilityHook.Hooked = {}
    AbilityHook.LastTap = {}
    AbilityHook._pendingFire = nil
    ahBindAnimator(char)
    task.wait(0.6)
    ahScanContainer()
end)

do
    if lp.Character then
        ahBindAnimator(lp.Character)
    end
end

task.spawn(function()
    while true do
        task.wait(1.5)
        ahScanContainer()
    end
end)

ahInstallUiWatcher()
ahScanContainer()

-- auto gen
AUTOGEN = { Enabled = false, Cooldown = 1.0, MaxDistance = 10, _nextFire = 0 }

local function getIngameMap()
    local map = workspace:FindFirstChild("Map")
    map = map and map:FindFirstChild("Ingame")
    return map and map:FindFirstChild("Map") or nil
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if not AUTOGEN.Enabled then continue end
        if tick() < AUTOGEN._nextFire then continue end
        local map = getIngameMap()
        local myRoot = getMyRoot()
        if not map or not myRoot then continue end
        local any = false
        for _, obj in ipairs(map:GetChildren()) do
            if (obj.Name == "Generator" or obj.Name == "FakeGenerator") and obj:IsA("Model") then
                local prog = obj:FindFirstChild("Progress")
                local main = obj:FindFirstChild("Main")
                if prog and main and prog.Value ~= 100 then
                    if (main.Position - myRoot.Position).Magnitude <= AUTOGEN.MaxDistance then
                        local remotes = obj:FindFirstChild("Remotes")
                        local re = remotes and remotes:FindFirstChild("RE")
                        if re then pcall(function() re:FireServer() end) any = true end
                    end
                end
            end
        end
        if any then AUTOGEN._nextFire = tick() + AUTOGEN.Cooldown end
    end
end)

-- esp
local espTrackers = { Killers = {}, Survivors = {}, Generators = {}, Items = {} }

local function attachHighlight(model, fill, outline, transparency, tracker, adornee)
    if not model or not model.Parent then return end
    local existing = tracker[model]
    local target = adornee or model
    if existing and existing.Parent then
        existing.Adornee = target
        existing.FillColor = fill
        existing.OutlineColor = outline or fill
        existing.FillTransparency = transparency or 0.65
        return
    end
    if existing then tracker[model] = nil end
    local hl = Instance.new("Highlight")
    hl.Name = "HunterESP"
    hl.Adornee = target
    hl.FillColor = fill
    hl.OutlineColor = outline or fill
    hl.FillTransparency = transparency or 0.65
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    tracker[model] = hl
end

local function detachHighlight(model, tracker)
    local hl = tracker[model]
    if hl then pcall(function() hl:Destroy() end) tracker[model] = nil end
end

local function refreshKillers()
    if not KillersFolder then return end
    local seen = {}
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character and k:FindFirstChild("HumanoidRootPart") then
            seen[k] = true
            local hl = espTrackers.Killers[k]
            if not hl or not hl.Parent then
                attachHighlight(k, Color3.fromRGB(255,40,40), Color3.fromRGB(255,0,0), 0.6, espTrackers.Killers)
            end
        end
    end
    for m in pairs(espTrackers.Killers) do
        if not seen[m] or not m.Parent then detachHighlight(m, espTrackers.Killers) end
    end
end

local function refreshSurvivors()
    if not SurvivorsFolder then return end
    local seen = {}
    for _, s in ipairs(SurvivorsFolder:GetChildren()) do
        if s:IsA("Model") and s ~= lp.Character and s:FindFirstChild("HumanoidRootPart") then
            seen[s] = true
            local hl = espTrackers.Survivors[s]
            if not hl or not hl.Parent then
                attachHighlight(s, Color3.fromRGB(40,255,90), Color3.fromRGB(0,220,60), 0.6, espTrackers.Survivors)
            end
        end
    end
    for m in pairs(espTrackers.Survivors) do
        if not seen[m] or not m.Parent then detachHighlight(m, espTrackers.Survivors) end
    end
end

local function refreshGenerators()
    local map = getIngameMap()
    local seen = {}
    if map then
        for _, g in ipairs(map:GetChildren()) do
            if g.Name == "Generator" and g:IsA("Model") then
                seen[g] = true
                local prog = g:FindFirstChild("Progress")
                local color = (prog and prog.Value >= 100) and Color3.fromRGB(0,220,60) or Color3.fromRGB(255,220,40)
                attachHighlight(g, color, color, 0.6, espTrackers.Generators)
            end
        end
    end
    for m in pairs(espTrackers.Generators) do
        if not seen[m] or not m.Parent then detachHighlight(m, espTrackers.Generators) end
    end
end

local ITEM_COLORS = { Medkit = Color3.fromRGB(255,105,180), BloxyCola = Color3.fromRGB(0,150,255) }

local function refreshItems()
    local ingame = workspace:FindFirstChild("Map")
    ingame = ingame and ingame:FindFirstChild("Ingame")
    local seen = {}
    if ingame then
        for _, item in ipairs(ingame:GetDescendants()) do
            local c = ITEM_COLORS[item.Name]
            if c and item:IsA("Tool") then
                local handle = item:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    seen[item] = true
                    attachHighlight(item, c, c, 0.5, espTrackers.Items, handle)
                end
            end
        end
    end
    for m in pairs(espTrackers.Items) do
        if not seen[m] or not m.Parent then detachHighlight(m, espTrackers.Items) end
    end
end

local function clearKillerESP() for m in pairs(espTrackers.Killers) do detachHighlight(m, espTrackers.Killers) end end
local function clearSurvivorESP() for m in pairs(espTrackers.Survivors) do detachHighlight(m, espTrackers.Survivors) end end
local function clearGeneratorESP() for m in pairs(espTrackers.Generators) do detachHighlight(m, espTrackers.Generators) end end
local function clearItemESP() for m in pairs(espTrackers.Items) do detachHighlight(m, espTrackers.Items) end end

task.spawn(function()
    while true do
        task.wait(0.4)
        if CFG.ESPKillers    then refreshKillers()    end
        if CFG.ESPSurvivors  then refreshSurvivors()  end
        if CFG.ESPGenerators then refreshGenerators() end
        if CFG.ESPItems      then refreshItems()      end
    end
end)

-- stam
local Sprinting = nil
pcall(function()
    Sprinting = require(ReplicatedStorage.Systems.Character.Game.Sprinting)
end)

local staminaBackup = {}
local staminaThread = nil

local function startInfiniteStamina()
    if not Sprinting or staminaThread then return end
    staminaBackup = { StaminaLossDisabled = Sprinting.StaminaLossDisabled }
    staminaThread = task.spawn(function()
        while CFG.InfiniteStamina do
            pcall(function()
                Sprinting.StaminaLossDisabled = true
                if Sprinting.Stamina ~= nil and Sprinting.MaxStamina then
                    Sprinting.Stamina = Sprinting.MaxStamina
                end
            end)
            task.wait(0.15)
        end
    end)
end

local function stopInfiniteStamina()
    if staminaThread then task.cancel(staminaThread) staminaThread = nil end
    if not Sprinting then return end
    pcall(function()
        if staminaBackup.StaminaLossDisabled ~= nil then
            Sprinting.StaminaLossDisabled = staminaBackup.StaminaLossDisabled
        end
    end)
end

-- stab
STAB = {
    Enabled = false, BehindOffset = 1.7, MaxRange = 60, Cooldown = 0.5,
    TeleportDelay = 0.02, FollowDuration = 0.5,
    _lastStab = 0, _stabbing = false, _followConn = nil,
    _savedAutoRotate = true, _animConn = nil,
}

local DAGGER_ANIM_IDS = {
    ["100725497418533"] = true,
    ["89448354637442"]  = true,
}

local function stabGetMyHRP()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function stabGetMyHum()
    local c = lp.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function stabGetKillerHRP(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
        or m:FindFirstChildWhichIsA("BasePart", true)
end

local function stabGetNearestKiller()
    if not KillersFolder then return nil, nil end
    local myRoot = stabGetMyHRP()
    if not myRoot then return nil, nil end
    local best, bestHRP, bestDist = nil, nil, math.huge
    for _, k in ipairs(KillersFolder:GetChildren()) do
        if k:IsA("Model") and k ~= lp.Character then
            local hrp = stabGetKillerHRP(k)
            local hum = k:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < bestDist then best, bestHRP, bestDist = k, hrp, d end
            end
        end
    end
    return best, bestHRP
end

local function stabStopFollow()
    if STAB._followConn then
        pcall(function() STAB._followConn:Disconnect() end)
        STAB._followConn = nil
    end
    local hum = stabGetMyHum()
    if hum then hum.AutoRotate = STAB._savedAutoRotate end
    STAB._stabbing = false
end

local function stabFollow(killerModel)
    if STAB._followConn then
        pcall(function() STAB._followConn:Disconnect() end)
        STAB._followConn = nil
    end
    local myHum = stabGetMyHum()
    STAB._savedAutoRotate = myHum and myHum.AutoRotate or true
    if myHum then myHum.AutoRotate = false end
    local endTime = os.clock() + STAB.FollowDuration
    STAB._followConn = RunService.RenderStepped:Connect(function()
        if os.clock() >= endTime or not STAB._stabbing then stabStopFollow() return end
        local h = stabGetMyHRP()
        if not h then stabStopFollow() return end
        local kHRP = killerModel and stabGetKillerHRP(killerModel)
        if not kHRP or not kHRP.Parent then stabStopFollow() return end
        local kCF = kHRP.CFrame
        local behindPos = kCF.Position - kCF.LookVector * STAB.BehindOffset
        local targetCF = CFrame.lookAt(
            Vector3.new(behindPos.X, h.Position.Y, behindPos.Z),
            Vector3.new(kCF.Position.X, h.Position.Y, kCF.Position.Z)
        )
        h.CFrame = h.CFrame:Lerp(targetCF, 0.5)
        h.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function stabActivate(force)
    if not force and not STAB.Enabled then return end
    if STAB._stabbing then return end
    if os.clock() - STAB._lastStab < STAB.Cooldown then return end
    local myHRP = stabGetMyHRP()
    if not myHRP then return end
    local killer, kHRP = stabGetNearestKiller()
    if not killer or not kHRP then return end
    if (kHRP.Position - myHRP.Position).Magnitude > STAB.MaxRange then return end

    STAB._stabbing = true
    STAB._lastStab = os.clock()
    local kCF = kHRP.CFrame
    local behindPos = kCF.Position - kCF.LookVector * STAB.BehindOffset
    local origin = myHRP.CFrame
    local behind = CFrame.lookAt(
        Vector3.new(behindPos.X, origin.Position.Y, behindPos.Z),
        Vector3.new(kCF.Position.X, origin.Position.Y, kCF.Position.Z)
    )
    task.wait(STAB.TeleportDelay)
    if not STAB.Enabled and not force then STAB._stabbing = false return end
    if not kHRP or not kHRP.Parent then STAB._stabbing = false return end
    local now = stabGetMyHRP()
    if not now then STAB._stabbing = false return end
    now.CFrame = behind
    now.AssemblyLinearVelocity = Vector3.zero
    stabFollow(killer)
end

local function stabBindAnimator()
    if STAB._animConn then
        pcall(function() STAB._animConn:Disconnect() end)
        STAB._animConn = nil
    end
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    STAB._animConn = animator.AnimationPlayed:Connect(function(track)
        if not STAB.Enabled then return end
        local a = track and track.Animation
        if not a then return end
        local id = tostring(a.AnimationId):match("%d+")
        if id and DAGGER_ANIM_IDS[id] then
            task.spawn(stabActivate)
        end
    end)
end

stabBindAnimator()
lp.CharacterAdded:Connect(function()
    stabStopFollow()
    task.wait(0.5)
    stabBindAnimator()
end)

-- azure qte
AZ = { AutoQTE = false, InfiniteQTE = false, qteHooked = false }

local function azHookQTE()
    if AZ.qteHooked then return true end
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Assets.Killers.Azure.Config.cl_WorkaroundModules.cl_ConstructQTE)
    end)
    if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then
        return false
    end
    local origNew = mod.new
    local success = pcall(function()
        mod.new = function(...)
            local qte = origNew(...)
            if qte then
                if AZ.InfiniteQTE then pcall(function() qte.FailedAttempts = -math.huge end) end
                if AZ.AutoQTE then
                    task.defer(function()
                        task.wait(0.12)
                        if AZ.AutoQTE and qte and type(qte.AddProgress) == "function" then
                            pcall(function() qte:AddProgress(100) end)
                        end
                    end)
                end
            end
            return qte
        end
    end)
    AZ.qteHooked = success
    return success
end

task.spawn(function()
    while true do
        task.wait(1.0)
        if (AZ.AutoQTE or AZ.InfiniteQTE) and not AZ.qteHooked then
            pcall(azHookQTE)
        end
    end
end)

-- hitbox expander
HBE = {
    Enabled = false, Mode = "Scale", SizeMultiplier = 1.5,
    ApplyOnlyOnAttack = false, Visualize = false,
    VelocitySpeed = 55, VelocityStopDist = 2,
    DragCooldown = 1.0,
    _char = nil, _hitbox = nil, _origSize = nil, _sizeConn = nil,
    _charConns = {}, _animConns = {}, _visuals = {}, _attackOpen = false,
    _dragConn = nil, _dragBV = nil, _dragOrigin = nil, _dragHum = nil,
    _dragCooldownUntil = 0,
}

local HBE_HITBOX_NAMES = { "CollisionHitbox", "Hitbox", "MainHitbox", "MeleeHitbox" }

local function hbeFindHitbox(char)
    if not char then return nil end
    for _, name in ipairs(HBE_HITBOX_NAMES) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:lower():find("hitbox", 1, true) then return d end
    end
    return nil
end

local function hbeDesiredSize()
    local p = HBE._hitbox
    if not p or not HBE._origSize then return nil end
    local active = (not HBE.ApplyOnlyOnAttack) or HBE._attackOpen
    if not active then return HBE._origSize end
    local m = HBE.SizeMultiplier
    return Vector3.new(HBE._origSize.X * m, HBE._origSize.Y * m, HBE._origSize.Z * m)
end

local function hbeDestroyVisuals()
    for _, v in ipairs(HBE._visuals) do
        if v and v.Parent then pcall(function() v:Destroy() end) end
    end
    HBE._visuals = {}
end

local function hbeApplyVisual()
    hbeDestroyVisuals()
    if not HBE.Visualize then return end
    local p = HBE._hitbox
    if not p or not p.Parent then return end
    local ad = Instance.new("BoxHandleAdornment")
    ad.Name = "HBE_Visual"
    ad.Adornee = p
    ad.AlwaysOnTop = true
    ad.ZIndex = 5
    ad.Color3 = Color3.fromRGB(255, 140, 0)
    ad.Transparency = 0.75
    ad.Size = p.Size
    ad.Parent = p
    HBE._visuals[1] = ad
end

local function hbeApply()
    local p = HBE._hitbox
    if not p or not p.Parent then return end
    local target = hbeDesiredSize()
    if not target then return end
    if (p.Size - target).Magnitude > 0.001 then p.Size = target end
    for _, v in ipairs(HBE._visuals) do if v and v.Parent then v.Size = target end end
end

local function hbeRevert()
    local p = HBE._hitbox
    if p and p.Parent and HBE._origSize then
        pcall(function() p.Size = HBE._origSize end)
    end
    hbeDestroyVisuals()
end

local function hbeStopDrag()
    if HBE._dragConn then
        pcall(function() HBE._dragConn:Disconnect() end)
        HBE._dragConn = nil
    end
    if HBE._dragBV and HBE._dragBV.Parent then
        pcall(function() HBE._dragBV:Destroy() end)
    end
    HBE._dragBV = nil

    if HBE._dragHum and HBE._dragHum.Parent and HBE._dragOrigin then
        pcall(function()
            HBE._dragHum.WalkSpeed = HBE._dragOrigin.walk
            HBE._dragHum.JumpPower = HBE._dragOrigin.jump
            HBE._dragHum.AutoRotate = HBE._dragOrigin.autoRot
        end)
    end
    HBE._dragHum = nil
    HBE._dragOrigin = nil

    HBE._dragCooldownUntil = tick() + (HBE.DragCooldown or 1.0)
end

local function hbeStartDrag()
    if HBE.Mode ~= "Velocity" then return end
    if HBE._dragConn then return end
    if tick() < (HBE._dragCooldownUntil or 0) then return end
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    HBE._dragHum = hum
    HBE._dragOrigin = { walk = hum.WalkSpeed, jump = hum.JumpPower, autoRot = hum.AutoRotate }
    hum.WalkSpeed = 0; hum.JumpPower = 0; hum.AutoRotate = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5); bv.Velocity = Vector3.zero
    bv.Parent = hrp; HBE._dragBV = bv

    HBE._dragConn = RunService.Heartbeat:Connect(function()
        if not HBE.Enabled or HBE.Mode ~= "Velocity" or not HBE._attackOpen then
            hbeStopDrag(); return
        end
        if not char.Parent or not hrp.Parent then
            hbeStopDrag(); return
        end
        local k = nearestKillerPart()
        if not k or not k.Parent then bv.Velocity = Vector3.zero return end
        local delta = k.Position - hrp.Position
        local horiz = Vector3.new(delta.X, 0, delta.Z)
        local dist = horiz.Magnitude
        if dist < HBE.VelocityStopDist then
            hbeStopDrag(); return
        end
        local dir = horiz.Unit
        bv.Velocity = Vector3.new(dir.X * HBE.VelocitySpeed, 0, dir.Z * HBE.VelocitySpeed)
        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(k.Position.X, hrp.Position.Y, k.Position.Z))
    end)
end

local function hbeDisconnectAll()
    if HBE._sizeConn then pcall(function() HBE._sizeConn:Disconnect() end) HBE._sizeConn = nil end
    for _, c in ipairs(HBE._charConns) do pcall(function() c:Disconnect() end) end
    HBE._charConns = {}
    for _, c in ipairs(HBE._animConns) do pcall(function() c:Disconnect() end) end
    HBE._animConns = {}
    hbeStopDrag()
end

local function hbeOnAttackOpen()
    if not HBE.Enabled or not HBE.ApplyOnlyOnAttack then return end
    HBE._attackOpen = true
    hbeApply()
    if HBE.Mode == "Velocity" then hbeStartDrag() end
end

local function hbeOnAttackClose()
    HBE._attackOpen = false
    if HBE.Mode == "Velocity" then hbeStopDrag() end
    if not HBE.Enabled then return end
    hbeApply()
end

local function hbeHookAnimator(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then
        task.delay(0.5, function()
            if HBE._char == char and HBE.Enabled then
                local h2 = char:FindFirstChildOfClass("Humanoid")
                local a2 = h2 and h2:FindFirstChildOfClass("Animator")
                if a2 then
                    local c = a2.AnimationPlayed:Connect(function(track)
                        if not HBE.Enabled then return end
                        hbeOnAttackOpen()
                        local dur = track.Length
                        if not dur or dur <= 0 then dur = 0.35 end
                        task.delay(dur + 0.05, hbeOnAttackClose)
                    end)
                    table.insert(HBE._animConns, c)
                end
            end
        end)
        return
    end
    local c = animator.AnimationPlayed:Connect(function(track)
        if not HBE.Enabled then return end
        local prio = track.Priority
        if prio ~= Enum.AnimationPriority.Action
           and prio ~= Enum.AnimationPriority.Action2
           and prio ~= Enum.AnimationPriority.Action3
           and prio ~= Enum.AnimationPriority.Action4 then return end
        hbeOnAttackOpen()
        local dur = track.Length
        if not dur or dur <= 0 then dur = 0.35 end
        task.delay(dur + 0.05, hbeOnAttackClose)
    end)
    table.insert(HBE._animConns, c)
end

local function hbeHookCharacter(char)
    if not char then return end
    HBE._char = char
    hbeDisconnectAll(); hbeRevert()
    HBE._hitbox = nil; HBE._origSize = nil; HBE._attackOpen = false
    HBE._dragCooldownUntil = 0

    task.spawn(function()
        local hitbox, t0 = nil, os.clock()
        while os.clock() - t0 < 6 do
            hitbox = hbeFindHitbox(char)
            if hitbox then break end
            task.wait(0.1)
        end
        if not hitbox or HBE._char ~= char or not HBE.Enabled then return end

        HBE._hitbox = hitbox
        HBE._origSize = hitbox.Size
        HBE._sizeConn = hitbox:GetPropertyChangedSignal("Size"):Connect(function()
            if not HBE.Enabled then return end
            local want = hbeDesiredSize()
            if not want then return end
            if (hitbox.Size - want).Magnitude > 0.01 then hitbox.Size = want end
        end)

        local c = char.ChildAdded:Connect(function(child)
            if not HBE.Enabled then return end
            for _, name in ipairs(HBE_HITBOX_NAMES) do
                if child.Name == name and child:IsA("BasePart") and child ~= hitbox then
                    if HBE._sizeConn then HBE._sizeConn:Disconnect() HBE._sizeConn = nil end
                    HBE._hitbox = child
                    HBE._origSize = child.Size
                    HBE._sizeConn = child:GetPropertyChangedSignal("Size"):Connect(function()
                        if not HBE.Enabled then return end
                        local want = hbeDesiredSize()
                        if not want then return end
                        if (child.Size - want).Magnitude > 0.01 then child.Size = want end
                    end)
                    hbeApply(); hbeApplyVisual()
                    break
                end
            end
        end)
        table.insert(HBE._charConns, c)
        if HBE.ApplyOnlyOnAttack then hbeHookAnimator(char) end
        hbeApply(); hbeApplyVisual()
    end)
end

local function hbeStart()
    HBE.Enabled = true
    if lp.Character then
        hbeHookCharacter(lp.Character)
    end
end

local function hbeStop()
    HBE.Enabled = false
    HBE._attackOpen = false
    hbeDisconnectAll(); hbeRevert()
    HBE._hitbox = nil; HBE._origSize = nil
end

lp.CharacterAdded:Connect(function(char)
    hbeStopDrag()
    if HBE.Enabled then
        task.wait(0.5)
        hbeHookCharacter(char)
    end
end)

-- block box
FacingVisual = {
    BoxEnabled = false,
    InRangeColor = Color3.fromRGB(255, 60, 60),
    OutRangeColor = Color3.fromRGB(255, 220, 60),
    PassColor = Color3.fromRGB(60, 255, 90),
    boxVisuals = {},
    GameBoxStyle = nil,
    FlashDuration = 0.25,
    FlashFade = 0.15,
    FlashOnKillerM1 = true,
    FlashOnEnterRange = false,
    FlashOnFacingFlip = false,
    FlashOnBlock = false,
    BoxWidth = 6,
    BoxLength = 15,
    BoxHeight = 6,
    BoxFill = 0.5,
    AutoWidth = false,
    BoxMaxAngle = 75,
    _blockPulse = 0,
    _lastBlockPulse = 0,
}

local function fvSniffGameBoxStyle()
    local roots = {}
    local map = workspace:FindFirstChild("Map")
    if map then roots[#roots + 1] = map end
    if KillersFolder then roots[#roots + 1] = KillersFolder end
    local scanned = 0
    for _, root in ipairs(roots) do
        local stopped = false
        for _, d in ipairs(root:GetDescendants()) do
            scanned += 1
            if scanned > 2000 then stopped = true break end
            if d:IsA("BasePart") and (d.Name:lower():find("hitbox") or d:FindFirstChild("HitboxHighlight")) then
                local hl = d:FindFirstChild("HitboxHighlight") or d:FindFirstChildOfClass("Highlight")
                if hl then
                    return {
                        Material = d.Material, Transparency = d.Transparency,
                        HighlightFillTransparency = hl.FillTransparency,
                        HighlightOutlineTransparency = hl.OutlineTransparency,
                        DepthMode = hl.DepthMode,
                    }
                end
            end
        end
        if stopped then break end
    end
    return {
        Material = Enum.Material.ForceField, Transparency = 0.5,
        HighlightFillTransparency = 1, HighlightOutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
    }
end

FacingVisual.GameBoxStyle = fvSniffGameBoxStyle()

local function fvStateColor(ir, fp)
    if ir and fp then return FacingVisual.PassColor end
    if ir then return FacingVisual.InRangeColor end
    return FacingVisual.OutRangeColor
end

local function addFacingBox(killer)
    if not killer or not killer:IsA("Model") then return end
    if FacingVisual.boxVisuals[killer] then return end
    FacingVisual.boxVisuals[killer] = {
        part = nil, highlight = nil,
        state = { inRange = false, facingPass = false },
        flashUntil = 0, fadeUntil = 0,
    }
end

local function removeFacingBox(killer)
    local data = FacingVisual.boxVisuals[killer]
    if not data then return end
    if data.highlight and data.highlight.Parent then pcall(function() data.highlight:Destroy() end) end
    if data.part and data.part.Parent then pcall(function() data.part:Destroy() end) end
    FacingVisual.boxVisuals[killer] = nil
end

local function fvBuildBox(data, color)
    local style = FacingVisual.GameBoxStyle or {}
    local part = Instance.new("Part")
    part.Name = "HunterFacingFlash"
    part.Anchored = true; part.CanCollide = false
    part.CanQuery = false; part.CanTouch = false
    part.CastShadow = false; part.Massless = true
    part.Material = style.Material or Enum.Material.ForceField
    part.Transparency = 1; part.Color = color
    part.Size = Vector3.new(1, 1, 1); part.Parent = workspace

    local hl = Instance.new("Highlight")
    hl.Name = "HunterFacingFlashHighlight"
    hl.Adornee = part
    hl.FillTransparency = 1; hl.FillColor = color
    hl.OutlineColor = color; hl.OutlineTransparency = 1
    hl.DepthMode = style.DepthMode or Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = part

    data.part = part
    data.highlight = hl
end

local function fvTriggerFlash(killer)
    local data = FacingVisual.boxVisuals[killer]
    if not data then return end
    local now = tick()
    data.flashUntil = now + (FacingVisual.FlashDuration or 0.25)
    data.fadeUntil  = data.flashUntil + (FacingVisual.FlashFade or 0.15)
end

local function updateBoxVisual(killer, data)
    local hrp = killer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local now = tick()
    local ir, fp = getFacingState(hrp)
    local color = fvStateColor(ir, fp)

    local st = data.state or { inRange = false, facingPass = false }
    local enteredRange = ir and not st.inRange
    local facingFlip   = ir and st.inRange and (fp ~= st.facingPass)
    data.state = { inRange = ir, facingPass = fp }

    if (FacingVisual.FlashOnEnterRange and enteredRange)
       or (FacingVisual.FlashOnFacingFlip and facingFlip) then
        fvTriggerFlash(killer)
    end

    if not data.part or not data.part.Parent or not data.highlight or not data.highlight.Parent then
        fvBuildBox(data, color)
    end
    local p  = data.part
    local hl = data.highlight

    local flashUntil = data.flashUntil or 0
    local fadeUntil  = data.fadeUntil or 0
    if now >= fadeUntil then
        if p.Transparency < 1 then p.Transparency = 1 end
        if hl.FillTransparency < 1 then hl.FillTransparency = 1 end
        if hl.OutlineTransparency < 1 then hl.OutlineTransparency = 1 end
        return
    end

    local alpha
    if now <= flashUntil then
        alpha = 1
    else
        local span = math.max(fadeUntil - flashUntil, 0.001)
        alpha = 1 - math.clamp((now - flashUntil) / span, 0, 1)
    end

    local length = FacingVisual.BoxLength or 15
    local width
    if FacingVisual.AutoWidth then
        local dot = facingDotClamped()
        local halfAngle = math.acos(dot)
        halfAngle = math.min(halfAngle, math.rad(FacingVisual.BoxMaxAngle or 75))
        width = 2 * length * math.tan(halfAngle)
        width = math.min(width, length * 3)
    else
        width = FacingVisual.BoxWidth or 6
    end
    if width < 0.1 then width = 0.1 end
    local height = FacingVisual.BoxHeight or 6
    if height < 0.1 then height = 0.1 end
    if length < 0.1 then length = 0.1 end

    p.Size = Vector3.new(width, height, length)
    local origin = hrp.Position
    local look   = hrp.CFrame.LookVector
    local center = origin + look * (length / 2)
    p.CFrame = CFrame.lookAt(center, center + look)
    p.Color = color
    p.Material = (FacingVisual.GameBoxStyle and FacingVisual.GameBoxStyle.Material) or Enum.Material.ForceField

    local baseTrans = FacingVisual.BoxFill or 0.5
    p.Transparency = math.clamp(baseTrans + (1 - alpha) * 0.8, 0, 1)
    hl.FillColor = color; hl.OutlineColor = color
    hl.FillTransparency    = 1
    hl.OutlineTransparency = 1 - alpha
end

function FacingVisual.FlashKiller(killerModel)
    if not FacingVisual.BoxEnabled then return end
    if not FacingVisual.FlashOnKillerM1 then return end
    if not killerModel or not killerModel:IsA("Model") then return end
    if not killerModel:FindFirstChild("HumanoidRootPart") then return end
    if not FacingVisual.boxVisuals[killerModel] then addFacingBox(killerModel) end
    fvTriggerFlash(killerModel)
end

task.spawn(function()
    while true do
        RunService.Heartbeat:Wait()
        if not FacingVisual.BoxEnabled then continue end
        if not KillersFolder then continue end

        if FacingVisual.FlashOnBlock then
            local pulse = FacingVisual._blockPulse or 0
            if pulse ~= FacingVisual._lastBlockPulse then
                FacingVisual._lastBlockPulse = pulse
                for _, k in ipairs(KillersFolder:GetChildren()) do
                    if k:IsA("Model") then
                        local hrp = k:FindFirstChild("HumanoidRootPart")
                        if hrp and inRange(hrp) then
                            if not FacingVisual.boxVisuals[k] then addFacingBox(k) end
                            fvTriggerFlash(k)
                        end
                    end
                end
            end
        end

        for _, k in ipairs(KillersFolder:GetChildren()) do
            if k:IsA("Model") and k:FindFirstChild("HumanoidRootPart") then
                if not FacingVisual.boxVisuals[k] then addFacingBox(k) end
                updateBoxVisual(k, FacingVisual.boxVisuals[k])
            end
        end
    end
end)

if KillersFolder then
    KillersFolder.ChildRemoved:Connect(function(k) removeFacingBox(k) end)
end

