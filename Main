local BLOOD_THEME = {
    Accent      = Color3.fromHex("#b30000"),
    Background  = Color3.fromHex("#120000"),
    Outline     = Color3.fromHex("#ff4d4d"),
    Text        = Color3.fromHex("#ffcccc"),
    Placeholder = Color3.fromHex("#7a0000"),
    Button      = Color3.fromHex("#3d0000"),
    Icon        = Color3.fromHex("#ff6666"),
}

do
    local ok = pcall(function() WindUI:AddTheme("Blood", BLOOD_THEME) end)
    if not ok then
        local t = table.clone(BLOOD_THEME)
        t.Name = "Blood"
        pcall(function() WindUI:AddTheme(t) end)
    end
end

local Window
local uiOk, uiErr = pcall(function()
    Window = WindUI:CreateWindow({
        Title = "hunter",
        Author = "gg",
        Theme = "Blood",
        Size = UDim2.fromOffset(620, 500),
        MinSize = Vector2.new(480, 380),
        ToggleKey = Enum.KeyCode.RightShift,
        Resizable = true,
        Folder = "hunter_hub",
    })

    local TAB_ICON_FALLBACKS = {
        ["sword"]    = { "swords", "sword", "zap", "circle" },
        ["settings"] = { "cog", "settings", "sliders", "circle" },
        ["palette"]  = { "palette", "brush", "circle" },
        ["box"]      = { "box", "square", "circle" },
        ["eye"]      = { "eye", "circle" },
        ["zap"]      = { "zap", "circle" },
        ["shield"]   = { "shield", "circle" },
        ["mouse-pointer"] = { "mouse-pointer", "mouse", "circle" },
        ["crosshair"]= { "crosshair", "target", "circle" },
    }
    local function makeTab(name, icon)
        local chain = TAB_ICON_FALLBACKS[icon] or { icon, "circle" }
        for _, ic in ipairs(chain) do
            local ok, tab = pcall(function()
                return Window:Tab({ Title = name, Icon = ic })
            end)
            if ok and tab then return tab end
        end
        local ok, tab = pcall(function() return Window:Tab({ Title = name }) end)
        if ok and tab then return tab end
        warn("[hunter] could not create tab:", name)
        return nil
    end

    local function safeSection(tab, title)
        if not tab then return nil end
        local ok, sec = pcall(function() return tab:Section({ Title = title }) end)
        if ok and sec then return sec end
        warn("[hunter] could not create section:", title)
        return nil
    end

    local function safe(sec, kind, opts)
        if not sec then return end
        local ok, err = pcall(function() sec[kind](sec, opts) end)
        if not ok then warn("[hunter] "..kind.." failed:", err) end
    end

    local ESPTab       = makeTab("esp", "eye")
    local StamTab      = makeTab("stam", "zap")
    local AutoBlockTab = makeTab("auto block", "shield")
    local HDTTab       = makeTab("hdt", "mouse-pointer")
    local AimTab       = makeTab("aim", "crosshair")
    local BoxTab       = makeTab("box", "box")
    local StabTab      = makeTab("stab", "sword")
    local MiscTab      = makeTab("misc", "settings")

    -- ESP
    do
        local S = safeSection(ESPTab, "players & world")
        safe(S, "Toggle", { Title = "killer",     Value = false, Callback = function(v) CFG.ESPKillers    = v if v then refreshKillers()    else clearKillerESP()    end end })
        safe(S, "Toggle", { Title = "survivor",   Value = false, Callback = function(v) CFG.ESPSurvivors  = v if v then refreshSurvivors()  else clearSurvivorESP()  end end })
        safe(S, "Toggle", { Title = "generators", Value = false, Callback = function(v) CFG.ESPGenerators = v if v then refreshGenerators() else clearGeneratorESP() end end })
        safe(S, "Toggle", { Title = "items",      Value = false, Callback = function(v) CFG.ESPItems      = v if v then refreshItems()      else clearItemESP()      end end })
    end

    -- STAM
    do
        local S = safeSection(StamTab, "sprint")
        if not Sprinting then
            safe(S, "Paragraph", { Title = "note", Desc = "no sprinting module found" })
        else
            safe(S, "Toggle", { Title = "infinite stamina", Value = false,
                Callback = function(v) CFG.InfiniteStamina = v if v then startInfiniteStamina() else stopInfiniteStamina() end end })
            safe(S, "Slider", { Title = "max",          Value = { Min = 1, Max = 1000, Default = Sprinting.MaxStamina or 100 }, Callback = function(v) if Sprinting then Sprinting.MaxStamina = v end end })
            safe(S, "Slider", { Title = "sprint speed", Value = { Min = 1, Max = 40,   Default = Sprinting.SprintSpeed or 26 }, Callback = function(v) if Sprinting then Sprinting.SprintSpeed = v end end })
            safe(S, "Slider", { Title = "gain",         Value = { Min = 1, Max = 200,  Default = Sprinting.StaminaGain or 20 }, Callback = function(v) if Sprinting then Sprinting.StaminaGain = v end end })
            safe(S, "Slider", { Title = "loss",         Value = { Min = 0, Max = 50,   Default = Sprinting.StaminaLoss or 10 }, Callback = function(v) if Sprinting then Sprinting.StaminaLoss = v end end })
        end
    end

    -- AUTO BLOCK
    do
        local S = safeSection(AutoBlockTab, "auto block")
        safe(S, "Toggle", { Title = "enabled", Value = false, Callback = function(v) CFG.AutoBlockEnabled = v end })
        safe(S, "Button", { Title = "toggle auto block", Callback = function()
            CFG.AutoBlockEnabled = not CFG.AutoBlockEnabled
            WindUI:Notify({
                Title = "auto block",
                Content = CFG.AutoBlockEnabled and "ENABLED" or "DISABLED",
                Duration = 2,
            })
        end })
        safe(S, "Paragraph", { Title = "info", Desc = "Fires ONLY when an M1 sound or M1 animation is detected, and only if you're inside the killer's forward view cone. Instant — fires the same frame." })
        safe(S, "Slider", { Title = "range", Value = { Min = 8, Max = 60, Default = CFG.DetectionRange }, Callback = function(v) CFG.DetectionRange = v end })
        safe(S, "Slider", { Title = "delay", Value = { Min = 0, Max = 0.5, Default = 0 }, Callback = function(v) CFG.BlockDelay = v end })
        safe(S, "Toggle", { Title = "sound trigger",     Value = true, Callback = function(v) CFG.SoundTrigger = v end })
        safe(S, "Toggle", { Title = "animation trigger", Value = true, Callback = function(v) CFG.AnimTrigger  = v end })
        safe(S, "Toggle", { Title = "wall check",        Value = true, Callback = function(v) CFG.WallCheck    = v end })
        safe(S, "Toggle", { Title = "facing check",      Value = true, Callback = function(v) CFG.FacingCheck  = v end })
        safe(S, "Slider", { Title = "facing dot", Value = { Min = -1, Max = 1, Default = CFG.FacingDot }, Callback = function(v) CFG.FacingDot = v end })
    end

    -- HDT
    do
        local S = safeSection(HDTTab, "hdt")
        safe(S, "Toggle", { Title = "enabled", Value = false, Callback = function(v) HDT.Enabled = v end })
        safe(S, "Toggle", { Title = "auto on block", Value = true, Callback = function(v) HDT.AutoTrigger = v end })
        safe(S, "Paragraph", { Title = "info", Desc = "HDT fires at most once every 27 seconds. No manual trigger — it auto-fires when a block is triggered." })
        safe(S, "Slider", { Title = "speed", Value = { Min = 2, Max = 40, Default = HDT.Speed }, Callback = function(v) HDT.Speed = v end })
        safe(S, "Slider", { Title = "delay", Value = { Min = 0, Max = 2, Default = HDT.Delay }, Callback = function(v) HDT.Delay = v end })
        safe(S, "Slider", { Title = "stop distance", Value = { Min = 1, Max = 8, Default = HDT.StopDistance }, Callback = function(v) HDT.StopDistance = v end })
        safe(S, "Slider", { Title = "max drag time", Value = { Min = 0.2, Max = 3, Default = HDT.SafetyTimeout }, Callback = function(v) HDT.SafetyTimeout = v end })
        safe(S, "Slider", { Title = "cooldown (s)", Value = { Min = 1, Max = 120, Default = HDT.Cooldown }, Callback = function(v) HDT.Cooldown = v end })
    end

    -- AIM
    do
        local S = safeSection(AimTab, "aim")
        safe(S, "Toggle", { Title = "enabled", Value = false, Callback = function(v) AIM.Enabled = v end })
        safe(S, "Keybind", { Title = "pulse 3s", Value = "C", Callback = function(v) if v and Enum.KeyCode[v] then AIM.AimFor(3.0) end end })
        safe(S, "Toggle", { Title = "debug", Value = false, Callback = function(v) AIM.Debug = v end })
        safe(S, "Toggle", { Title = "aim on stun tap", Value = true, Callback = function(v)
            AbilityHook.Enabled = v
            if v then ahScanContainer() ahInstallUiWatcher() end
        end })
        safe(S, "Slider", { Title = "ability cooldown", Value = { Min = 0, Max = 60, Default = AbilityHook.Cooldown }, Callback = function(v) AbilityHook.Cooldown = v end })
        safe(S, "Slider", { Title = "confirm window", Value = { Min = 0.1, Max = 1.0, Default = AbilityHook.PendingWindow }, Callback = function(v) AbilityHook.PendingWindow = v end })
        safe(S, "Paragraph", { Title = "info", Desc = "aim fires only after the ability's Action animation actually plays." })
        safe(S, "Slider", { Title = "lock multiplier", Value = { Min = 0.5, Max = 4, Default = AbilityHook.LockMultiplier }, Callback = function(v) AbilityHook.LockMultiplier = v end })
        safe(S, "Dropdown", { Title = "aim mode", Values = {"Camera", "HRP", "HRP+Camera"}, Value = "Camera", Callback = function(opt) AIM.AimMode = opt end })
        safe(S, "Slider", { Title = "smooth", Value = { Min = 0.05, Max = 1, Default = AIM.Smooth }, Callback = function(v) AIM.Smooth = v end })
        safe(S, "Dropdown", { Title = "prediction mode", Values = {"Off", "Ping", "Velocity", "Both"}, Value = "Both", Callback = function(opt) AIM.PredictMode = opt end })
        safe(S, "Slider", { Title = "velocity lead", Value = { Min = 0, Max = 0.5, Default = AIM.PredictLead }, Callback = function(v) AIM.PredictLead = v end })
        safe(S, "Slider", { Title = "ping mult", Value = { Min = 0, Max = 2, Default = AIM.PingMult }, Callback = function(v) AIM.PingMult = v end })
    end

    -- BOX
    do
        local S = safeSection(BoxTab, "box")
        safe(S, "Toggle", { Title = "enabled", Value = false, Callback = function(v)
            FacingVisual.BoxEnabled = v
            if not v then
                for _, data in pairs(FacingVisual.boxVisuals) do
                    if data.highlight and data.highlight.Parent then pcall(function() data.highlight:Destroy() end) end
                    if data.part and data.part.Parent then pcall(function() data.part:Destroy() end) end
                end
                FacingVisual.boxVisuals = {}
            end
        end })
        safe(S, "Toggle", { Title = "flash on killer m1", Value = true, Callback = function(v) FacingVisual.FlashOnKillerM1 = v end })
        safe(S, "Slider", { Title = "width",  Value = { Min = 0, Max = 30, Default = FacingVisual.BoxWidth },  Callback = function(v) FacingVisual.BoxWidth = v end })
        safe(S, "Slider", { Title = "length", Value = { Min = 0, Max = 30, Default = FacingVisual.BoxLength }, Callback = function(v) FacingVisual.BoxLength = v end })
        safe(S, "Slider", { Title = "height", Value = { Min = 0, Max = 30, Default = FacingVisual.BoxHeight }, Callback = function(v) FacingVisual.BoxHeight = v end })
        safe(S, "Toggle", { Title = "auto width", Value = false, Callback = function(v) FacingVisual.AutoWidth = v end })
        safe(S, "Slider", { Title = "transparency", Value = { Min = 0, Max = 0.95, Default = FacingVisual.BoxFill }, Callback = function(v) FacingVisual.BoxFill = v end })
        safe(S, "ColorPicker", { Title = "pass color",      Color = FacingVisual.PassColor,     Callback = function(c) FacingVisual.PassColor = c end })
        safe(S, "ColorPicker", { Title = "in range color",  Color = FacingVisual.InRangeColor,  Callback = function(c) FacingVisual.InRangeColor = c end })
        safe(S, "ColorPicker", { Title = "out range color", Color = FacingVisual.OutRangeColor, Callback = function(c) FacingVisual.OutRangeColor = c end })
        safe(S, "Slider", { Title = "flash duration", Value = { Min = 0.05, Max = 1.0, Default = FacingVisual.FlashDuration }, Callback = function(v) FacingVisual.FlashDuration = v end })
        safe(S, "Slider", { Title = "fade", Value = { Min = 0.0, Max = 1.0, Default = FacingVisual.FlashFade }, Callback = function(v) FacingVisual.FlashFade = v end })
        safe(S, "Toggle", { Title = "flash on enter range", Value = false, Callback = function(v) FacingVisual.FlashOnEnterRange = v end })
        safe(S, "Toggle", { Title = "flash on facing flip", Value = false, Callback = function(v) FacingVisual.FlashOnFacingFlip = v end })
        safe(S, "Toggle", { Title = "flash on block fire",  Value = false, Callback = function(v) FacingVisual.FlashOnBlock = v end })
        safe(S, "Button", { Title = "reset 6/15/6", Callback = function()
            FacingVisual.BoxWidth = 6 FacingVisual.BoxLength = 15 FacingVisual.BoxHeight = 6 FacingVisual.AutoWidth = false
        end })
    end

    -- STAB
    do
        local S = safeSection(StabTab, "stab")
        safe(S, "Toggle", { Title = "enabled", Value = false, Callback = function(v) STAB.Enabled = v end })
        safe(S, "Keybind", { Title = "manual stab", Value = "H", Callback = function(v)
            if v and Enum.KeyCode[v] then task.spawn(function() stabActivate(true) end) end
        end })
        safe(S, "Slider", { Title = "behind offset", Value = { Min = 0.5, Max = 6, Default = STAB.BehindOffset }, Callback = function(v) STAB.BehindOffset = v end })
        safe(S, "Slider", { Title = "max range", Value = { Min = 10, Max = 150, Default = STAB.MaxRange }, Callback = function(v) STAB.MaxRange = v end })
        safe(S, "Slider", { Title = "cooldown", Value = { Min = 0.1, Max = 2, Default = STAB.Cooldown }, Callback = function(v) STAB.Cooldown = v end })
        safe(S, "Slider", { Title = "tp delay", Value = { Min = 0, Max = 0.2, Default = STAB.TeleportDelay }, Callback = function(v) STAB.TeleportDelay = v end })
        safe(S, "Slider", { Title = "follow duration", Value = { Min = 0.1, Max = 2, Default = STAB.FollowDuration }, Callback = function(v) STAB.FollowDuration = v end })
        safe(S, "Button", { Title = "stab now", Callback = function() task.spawn(function() stabActivate(true) end) end })
    end

    -- MISC
    do
        local S = safeSection(MiscTab, "misc")
        safe(S, "Toggle", { Title = "auto qte", Value = false, Callback = function(v) AZ.AutoQTE = v if v then azHookQTE() end end })
        safe(S, "Toggle", { Title = "inf qte",  Value = false, Callback = function(v) AZ.InfiniteQTE = v if v then azHookQTE() end end })
        safe(S, "Toggle", { Title = "auto generator", Value = false, Callback = function(v) AUTOGEN.Enabled = v end })
        safe(S, "Slider", { Title = "gen range",    Value = { Min = 5, Max = 30, Default = AUTOGEN.MaxDistance }, Callback = function(v) AUTOGEN.MaxDistance = v end })
        safe(S, "Slider", { Title = "gen interval", Value = { Min = 0.3, Max = 5, Default = AUTOGEN.Cooldown }, Callback = function(v) AUTOGEN.Cooldown = v end })
        safe(S, "Toggle", { Title = "hitbox expander", Value = false, Callback = function(v) if v then hbeStart() else hbeStop() end end })
        safe(S, "Dropdown", { Title = "hbe mode", Values = {"Scale", "Velocity"}, Value = "Scale", Callback = function(opt)
            HBE.Mode = opt or "Scale"
            if HBE.Enabled then hbeStop() hbeStart() end
        end })
        safe(S, "Slider", { Title = "size multiplier", Value = { Min = 1, Max = 5, Default = HBE.SizeMultiplier }, Callback = function(v) HBE.SizeMultiplier = v if HBE.Enabled then hbeApply() end end })
        safe(S, "Toggle", { Title = "hbe only on attack", Value = false, Callback = function(v)
            HBE.ApplyOnlyOnAttack = v
            if HBE.Enabled and lp.Character then hbeDisconnectAll() hbeHookCharacter(lp.Character) end
        end })
        safe(S, "Toggle", { Title = "hbe visualize", Value = false, Callback = function(v) HBE.Visualize = v hbeApplyVisual() end })
        safe(S, "Slider", { Title = "drag cooldown", Value = { Min = 0, Max = 5, Default = HBE.DragCooldown }, Callback = function(v) HBE.DragCooldown = v end })
        safe(S, "Button", { Title = "1.25x", Callback = function() HBE.SizeMultiplier = 1.25 if HBE.Enabled then hbeApply() end end })
        safe(S, "Button", { Title = "1.50x", Callback = function() HBE.SizeMultiplier = 1.5  if HBE.Enabled then hbeApply() end end })
        safe(S, "Button", { Title = "2.00x", Callback = function() HBE.SizeMultiplier = 2.0  if HBE.Enabled then hbeApply() end end })
        safe(S, "Button", { Title = "fullbright", Callback = function()
            Lighting.Ambient = Color3.new(1,1,1)
            Lighting.OutdoorAmbient = Color3.new(1,1,1)
            Lighting.Brightness = 2; Lighting.ClockTime = 12
            local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
            if atmo then atmo:Destroy() end
        end })
        safe(S, "Button", { Title = "show chat", Callback = function()
            pcall(function()
                local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
                local inp = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
                if cfg then cfg.Enabled = true end
                if inp then inp.Enabled = true end
            end)
        end })
        safe(S, "Button", { Title = "reset character", Callback = function()
            local char = lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        end })
        safe(S, "Button", { Title = "anti lag", Callback = function()
            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/zxcursedsocute/Forsaken-Script/refs/heads/main/anti%20lag%20test"))()
                end)
            end)
        end })
        safe(S, "Button", { Title = "copy discord", Callback = function()
            local link = "https://discord.gg/ecCpZY8u5"
            if setclipboard then
                pcall(setclipboard, link)
                WindUI:Notify({
                    Title = "discord",
                    Content = "link copied: " .. link,
                    Duration = 4,
                })
            else
                WindUI:Notify({
                    Title = "discord",
                    Content = link,
                    Duration = 6,
                })
            end
        end })
        safe(S, "Button", { Title = "theme: Blood (default)", Callback = function() WindUI:SetTheme("Blood") end })
        safe(S, "Button", { Title = "theme: Dark",           Callback = function() WindUI:SetTheme("Dark") end })
        safe(S, "Button", { Title = "theme: Crimson",        Callback = function() WindUI:SetTheme("Crimson") end })
    end
end)

if not uiOk then
    warn("[hunter] UI build failed:", uiErr)
    return
end

WindUI:Notify({
    Title = "hunter",
    Content = "loaded — instant block, HDT 27s cd",
    Duration = 4,
})
